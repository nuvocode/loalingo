{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loalingo",
  "version": "0.1.0",
  "identifier": "com.nuvocode.loalingo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm fetch-model && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "loalingo",
        "width": 1366,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  }
}
